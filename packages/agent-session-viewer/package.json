{
	"type": "module",
	"name": "@oh-my-pi/agent-session-viewer",
	"version": "13.12.6",
	"description": "Standalone coding-agent session viewer",
	"homepage": "https://github.com/can1357/oh-my-pi",
	"author": "Scott Hyndman",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/agent-session-viewer"
	},
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"keywords": [
		"agent",
		"session",
		"viewer",
		"cli"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"agent-session-viewer": "src/cli.ts"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json",
		"test": "bun test test/*.test.ts"
	},
	"dependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*",
		"@oh-my-pi/pi-tui": "workspace:*",
		"@oh-my-pi/pi-utils": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"files": [
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	}
}
