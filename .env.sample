# Secrets for scripts/local-registry-setup.sh
# Copy this file to .env (or set LOCAL_REGISTRY_ENV_FILE) and fill in the values.
# The .env file itself can be backed by 1Password or any domain socket provider.

# Required credentials for publishing to Verdaccio
LOCAL_REGISTRY_USERNAME=your-verdaccio-user
LOCAL_REGISTRY_PASSWORD=supersecret
LOCAL_REGISTRY_EMAIL=you@example.com

# Optional overrides
# LOCAL_REGISTRY_URL=http://localhost:4873
# LOCAL_REGISTRY_STATE_DIR=$HOME/.omp/local-registry
# LOCAL_REGISTRY_TAG=local
# LOCAL_REGISTRY_BUILD_ID=local.$(date +%y%m%d-%H%M%S)
# LOCAL_REGISTRY_ENV_FILE=/path/to/custom.env
